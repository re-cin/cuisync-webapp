# Copy this file to .env and fill in the values. Never commit .env.
# Supabase: Project Settings -> API Keys (and Data API for the URL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# First admin account (created on start if Supabase has no admin yet)
CUISYNC_ADMIN_USER=admin
CUISYNC_ADMIN_EMAIL=admin@cuisync.app
CUISYNC_ADMIN_PASSWORD=cuisync-admin
